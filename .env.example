# =====================================================
# SOEP — Structured Output Extraction Pipeline
# Environment Variables Example
# Copy this file to .env and fill in your values.
# =====================================================

# Optional: Provide a Gemini API key to enable live LLM extraction
# as a fallback when deterministic regex extraction is insufficient.
# Leave blank (or omit the file entirely) to run in pure
# pattern-based deterministic mode (fully offline).
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (default: 3000)
PORT=3000
